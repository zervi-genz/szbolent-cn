# =============================================================
# szbolent.cn 部署栈环境变量模板
#   复制为 .env 后填真值；CI 由 GitHub Secrets 注入，不入库。
#   cp .env.example .env
# =============================================================

# ---------- 内容线 WordPress ----------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bolent_wp
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
WP_HOME=http://<DEPLOY_HOST>
WP_SITEURL=http://<DEPLOY_HOST>

# ---------- 实验向量库 pgvector ----------
PGVECTOR_PASSWORD=change-me
